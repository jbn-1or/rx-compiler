fn make(tag: i32) -> Box<i32> { println_i32(tag); Box::<i32>::new(7) }

fn index(tag: i32) -> usize { println_i32(tag); 0 }

fn compare_or_return(stop_left: bool, stop_right: bool) -> i32 {
    ({
        println_i32(10);
        if stop_left { return 31; }
        Box::<i32>::new(7)
    } == {
        println_i32(20);
        if stop_right { return 32; }
        Box::<i32>::new(8)
    }) as i32
}

fn main() {
    println_i32((make(1) == make(2)) as i32);
    println_i32((make(1) != make(2)) as i32);
    let left = [Box::<i32>::new(7)];
    let right = [Box::<i32>::new(8)];
    println_i32((left[index(3)] != right[index(4)]) as i32);
    println_i32(*left[0]);
    println_i32(*right[0]);
    println_i32(compare_or_return(true, false));
    println_i32(compare_or_return(false, true));
    println_i32(compare_or_return(false, false));
}
