fn main() {
    let mut v = Vec::<i32>::new();
    v.push(10); v.push(20); v.push(30); v.push(40);
    println_i32(v.remove(0));
    println_i32(v.remove(1));
    println_i32(v.remove(1));
    println_i32(v[0]);
    println_i32(v.remove(0));
    println_i32(v.is_empty() as i32);
    v.push(50);
    println_i32(v[0]);
}
