// A -> B -> A reaches a real back edge before terminating at an empty Vec.
#[derive(Clone, PartialEq, Eq)]
struct A { value: i32, children: Vec<B> }
#[derive(Clone, PartialEq, Eq)]
struct B { children: Vec<A> }

fn main() {
    let leaf = A { value: 2, children: Vec::<B>::new() };
    let mut as_children = Vec::<A>::new();
    as_children.push(leaf);
    let mut bs_children = Vec::<B>::new();
    bs_children.push(B { children: as_children });
    let tree = A { value: 1, children: bs_children };
    let mut copied = tree.clone();
    println_i32((tree == copied) as i32);
    copied.children[0].children[0].value = 9;
    println_i32((tree == copied) as i32);
    println_i32(tree.children[0].children[0].value);
    println_i32(copied.children[0].children[0].value);
}
